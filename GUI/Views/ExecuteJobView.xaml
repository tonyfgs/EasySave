<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GUI.ViewModels"
             xmlns:model="clr-namespace:Model;assembly=Model"
             xmlns:dto="clr-namespace:Application.DTOs;assembly=Application"
             x:Class="GUI.Views.ExecuteJobView"
             x:DataType="vm:ExecuteJobViewModel">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="20">

        <!-- Header -->
        <Label Grid.Row="0"
               Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Localization.ExecuteTitle}"
               FontSize="24" FontAttributes="Bold" Margin="0,0,0,10"/>

        <!-- Job selection list with checkboxes -->
        <Border Grid.Row="1" Stroke="#E0E0E0" StrokeThickness="1"
                StrokeShape="RoundRectangle 8" Padding="0">
            <CollectionView ItemsSource="{Binding AvailableJobs}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No jobs available. Create a job first."
                           HorizontalOptions="Center" VerticalOptions="Center"
                           FontSize="16" TextColor="Gray" Margin="20"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:JobProgress">
                        <Grid Padding="15,8" ColumnDefinitions="*,Auto">
                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#E3F2FD"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="False">
                                    <Setter Property="BackgroundColor" Value="Transparent"/>
                                </DataTrigger>
                            </Grid.Triggers>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.SelectJobCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>

                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <HorizontalStackLayout>
                                    <Label Text="{Binding Job.Name}" FontSize="15" FontAttributes="Bold"/>
                                    <Label
                                        Margin="10,0,0,0"
                                        Text="{Binding Job.Type}"
                                        FontSize="12" TextColor="#1976D2"
                                        VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Job.SourcePath}" FontSize="11" TextColor="Gray"/>
                                <ProgressBar Progress="{Binding Progress, Converter={StaticResource IntToDoubleConverter}}"
                                             ProgressColor="#1976D2"
                                             IsVisible="{Binding IsSelected}"/>
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Button Text="{Binding PauseResumeLabel}"
                                        IsVisible="{Binding IsSelected}"
                                        Command="{Binding PauseCommand}"/>
                                <Button Text="Stop"
                                        IsVisible="{Binding IsSelected}"
                                        Command="{Binding StopCommand}"/>
                                <Label Text="{Binding Progress, StringFormat='{0}%'}"
                                       FontSize="12" TextColor="#1976D2"
                                       IsVisible="{Binding IsSelected}"/>
                            </HorizontalStackLayout>

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <!-- Progress section -->
        <VerticalStackLayout Grid.Row="2" Spacing="8" Margin="0,10,0,10">
            <!-- Progress Bar -->
            <ProgressBar Progress="{Binding OverallProgress, Converter={StaticResource IntToDoubleConverter}}"
                         ProgressColor="#1976D2"
                         IsVisible="{Binding IsExecuting}"/>

            <!-- Progress Details -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding IsExecuting}">
                <Label Grid.Column="0"
                       Text="{Binding OverallProgress, StringFormat='{0}%'}"
                       FontAttributes="Bold" FontSize="14" TextColor="#1976D2"/>
                <Label Grid.Column="1" FontSize="12" TextColor="Gray">
                    <Label.Text>
                        <MultiBinding StringFormat="{}{0}/{1} files">
                            <Binding Path="FilesProcessed"/>
                            <Binding Path="TotalFiles"/>
                        </MultiBinding>
                    </Label.Text>
                </Label>
            </Grid>

            <!-- Current File -->
            <Label Text="{Binding CurrentFile, StringFormat='Processing: {0}'}"
                   FontSize="12" TextColor="Gray"
                   IsVisible="{Binding CurrentFile, Converter={StaticResource StringNotEmptyConverter}}"/>

            <!-- Status Message -->
            <Label Text="{Binding StatusMessage}"
                   TextColor="Gray" FontSize="14"/>

            <!-- Results -->
            <CollectionView ItemsSource="{Binding Results}"
                            IsVisible="{Binding Results.Count, Converter={StaticResource IntToBoolConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:JobExecutionResult">
                        <HorizontalStackLayout Spacing="8" Padding="5,2">
                            <Label Text="●" FontSize="12"
                                   TextColor="{Binding Result.Success, Converter={StaticResource BoolToColorConverter}}"/>
                            <Label FontSize="13">
                                <Label.Text>
                                    <MultiBinding StringFormat="Job {0}: {1}">
                                        <Binding Path="JobId"/>
                                        <Binding Path="Result.Success"
                                                 Converter="{StaticResource BoolToResultTextConverter}"/>
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <!-- Action Buttons -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Grid.Column="0"
                    Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Localization.ExecuteSelected}"
                    Command="{Binding ExecuteSelectedCommand}"
                    BackgroundColor="#1976D2" TextColor="White"/>
            <Button Grid.Column="1"
                    Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Localization.ExecuteAll}"
                    Command="{Binding ExecuteAllCommand}"
                    BackgroundColor="#2E7D32" TextColor="White"/>
        </Grid>

    </Grid>
</ContentView>
