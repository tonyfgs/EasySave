<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GUI.ViewModels"
             xmlns:controls="clr-namespace:GUI.Views.Controls"
             x:Class="GUI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="25">

            <Label Text="{Binding Localization.SettingsTitle}"
                   FontSize="28" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#212121, Dark=#FFFFFF}"
                   Margin="0,0,0,10"/>

            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    Padding="20"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{Binding Localization.LanguageLabel}"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="#1976D2"/>

                    <HorizontalStackLayout Spacing="10">
                        <Button Text="FR"
                                Command="{Binding SelectFrenchCommand}"
                                BackgroundColor="{Binding FrenchButtonColor}"
                                TextColor="White"
                                WidthRequest="130" HeightRequest="48"
                                CornerRadius="8"/>

                        <Button Text="EN"
                                Command="{Binding SelectEnglishCommand}"
                                BackgroundColor="{Binding EnglishButtonColor}"
                                TextColor="White"
                                WidthRequest="130" HeightRequest="48"
                                CornerRadius="8"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    Padding="20"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{Binding Localization.LogFormatLabel}"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="#1976D2"/>

                    <HorizontalStackLayout Spacing="10">
                        <Button Text="JSON"
                                Command="{Binding SelectJsonCommand}"
                                BackgroundColor="{Binding JsonButtonColor}"
                                TextColor="White" WidthRequest="110"/>
                        <Button Text="XML"
                                Command="{Binding SelectXmlCommand}"
                                BackgroundColor="{Binding XmlButtonColor}"
                                TextColor="White" WidthRequest="110"/>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Encryption Section -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    Padding="20"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding Localization.EncryptionTitle}"
                           FontSize="18" FontAttributes="Bold" TextColor="#1976D2"/>

                    <Label Text="{Binding Localization.EncryptedExtensionsLabel}" FontSize="14"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#BBBBBB}"/>

                    <controls:ChipInputView
                        AvailableItems="{Binding AvailableExtensions}"
                        SelectedItems="{Binding SelectedExtensions}"
                        Placeholder="{Binding Localization.ExtensionsSearchPlaceholder}"
                        AllowCustomItems="True"/>

                    <Label Text="{Binding Localization.EncryptionKeyLabel}" FontSize="14" Margin="0,5,0,0"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#BBBBBB}"/>
                    <Entry Text="{Binding EncryptionKey}"
                           IsPassword="True"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#2C2C2C}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Business Software Detection Section -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    Padding="20"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{Binding Localization.BusinessSoftwareTitle}"
                           FontSize="18" FontAttributes="Bold" TextColor="#1976D2"/>

                    <HorizontalStackLayout Spacing="10">
                        <CheckBox IsChecked="{Binding DetectionEnabled}" Color="#1976D2"/>
                        <Label Text="{Binding Localization.EnableDetectionLabel}"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    </HorizontalStackLayout>

                    <controls:ChipInputView
                        AvailableItems="{Binding AvailableBusinessSoftware}"
                        SelectedItems="{Binding SelectedBusinessSoftware}"
                        Placeholder="{Binding Localization.SoftwareSearchPlaceholder}"
                        AllowCustomItems="True"
                        MaxItems="1"
                        IsEnabled="{Binding DetectionEnabled}"/>
                </VerticalStackLayout>
            </Border>

            <Button Text="{Binding Localization.SaveButton}"
                    Command="{Binding SaveSettingsCommand}"
                    BackgroundColor="#2E7D32"
                    TextColor="White"
                    FontSize="18" FontAttributes="Bold"
                    HeightRequest="55" CornerRadius="10"
                    Margin="0,10,0,10"/>

            <Frame BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#0D47A1}"
                   BorderColor="#2196F3" Padding="15" HasShadow="False">
                <HorizontalStackLayout Spacing="15">
                    <Label Text="ℹ️" FontSize="22" VerticalOptions="Center"/>
                    <Label Text="{Binding Localization.SettingsInfo}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#1565C0, Dark=#E3F2FD}"
                           LineBreakMode="WordWrap"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
