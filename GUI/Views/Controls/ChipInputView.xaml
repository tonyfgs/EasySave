<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GUI.Views.Controls.ChipInputView">

    <VerticalStackLayout Spacing="0">
        <!-- Input container -->
        <Border x:Name="InputBorder"
                StrokeShape="RoundRectangle 8"
                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                Padding="8,6">
            <Grid ColumnDefinitions="*,Auto">
                <FlexLayout x:Name="ChipsContainer"
                            Wrap="Wrap"
                            AlignItems="Center"
                            Direction="Row"
                            Grid.Column="0">
                    <Entry x:Name="SearchEntry"
                           Placeholder="Search..."
                           BackgroundColor="Transparent"
                           FontSize="14"
                           MinimumWidthRequest="120"
                           TextColor="{AppThemeBinding Light=#212121, Dark=#FFFFFF}"
                           PlaceholderColor="{AppThemeBinding Light=#9E9E9E, Dark=#757575}"
                           Completed="OnSearchEntryCompleted"
                           TextChanged="OnSearchTextChanged"
                           Focused="OnSearchEntryFocused"
                           Unfocused="OnSearchEntryUnfocused"/>
                </FlexLayout>

                <ImageButton x:Name="ClearAllButton"
                             Grid.Column="1"
                             Source="close_icon.png"
                             WidthRequest="20"
                             HeightRequest="20"
                             VerticalOptions="Center"
                             Margin="4,0,4,0"
                             Clicked="OnClearAllClicked"
                             IsVisible="False"
                             Opacity="0.5"/>
            </Grid>
        </Border>

        <!-- Dropdown suggestions -->
        <Border x:Name="DropdownBorder"
                IsVisible="False"
                StrokeShape="RoundRectangle 0,0,8,8"
                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444444}"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                Padding="4"
                MaximumHeightRequest="200">
            <ScrollView>
                <VerticalStackLayout x:Name="SuggestionsList" Spacing="0"/>
            </ScrollView>
        </Border>
    </VerticalStackLayout>

</ContentView>
