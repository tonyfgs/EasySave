<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GUI.ViewModels"
             x:Class="GUI.Views.CreateJobView"
             x:DataType="vm:CreateJobViewModel">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15" MaximumWidthRequest="600">

            <!-- Title -->
            <Label Text="{Binding FormTitle}"
                   FontSize="24" FontAttributes="Bold"/>

            <!-- Job Name -->
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Localization.ExecuteTitle}"
                       FontSize="14" FontAttributes="Bold"/>
                <Entry Text="{Binding Name}"
                       Placeholder="e.g. Daily Backup"
                       ClearButtonVisibility="WhileEditing"/>
            </VerticalStackLayout>

            <!-- Source Path -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Source Path" FontSize="14" FontAttributes="Bold"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0"
                           Text="{Binding SourcePath}"
                           Placeholder="C:\Users\Documents"/>
                    <Button Grid.Column="1"
                            Text="Browse"
                            Command="{Binding BrowseSourceCommand}"
                            VerticalOptions="Center"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Target Path -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Target Path" FontSize="14" FontAttributes="Bold"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0"
                           Text="{Binding TargetPath}"
                           Placeholder="D:\Backups"/>
                    <Button Grid.Column="1"
                            Text="Browse"
                            Command="{Binding BrowseTargetCommand}"
                            VerticalOptions="Center"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Backup Type -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Backup Type" FontSize="14" FontAttributes="Bold"/>
                <Picker ItemsSource="{Binding BackupTypes}"
                        SelectedItem="{Binding SelectedType}"/>
            </VerticalStackLayout>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                <Button Grid.Column="0"
                        Text="Cancel"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="#E0E0E0" TextColor="Black"/>
                <Button Grid.Column="1"
                        Text="{Binding IsEditMode, Converter={StaticResource BoolToSaveTextConverter}}"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="#1976D2" TextColor="White"/>
            </Grid>

            <!-- Status Message -->
            <Label Text="{Binding StatusMessage}"
                   TextColor="Gray" FontSize="14"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   Margin="0,5,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
