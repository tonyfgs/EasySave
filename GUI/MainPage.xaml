<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GUI.ViewModels"
             xmlns:views="clr-namespace:GUI.Views"
             x:Class="GUI.MainPage"
             x:DataType="vm:MainViewModel"
             Title="EasySave">

    <Grid ColumnDefinitions="220,*">

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0"
                BackgroundColor="#F5F5F5"
                StrokeThickness="0">
            <VerticalStackLayout Spacing="0" Padding="15">

                <!-- App Title -->
                <Label Text="{Binding Localization.AppTitle}"
                       FontSize="22" FontAttributes="Bold"
                       TextColor="#1976D2"
                       Margin="10,10,10,20"/>

                <!-- Nav Buttons -->
                <Grid HeightRequest="44" ColumnDefinitions="30,*" Padding="10,0" HorizontalOptions="Fill">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowJobListCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" Text="📋" FontSize="15" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding Localization.JobListNav}"
                           TextColor="Black"
                           FontSize="15"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"/>
                </Grid>

                <Grid HeightRequest="44" ColumnDefinitions="30,*" Padding="10,0" HorizontalOptions="Fill">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowCreateJobCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" Text="➕" FontSize="15" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding Localization.CreateJobNav}"
                           TextColor="Black"
                           FontSize="15"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"/>
                </Grid>

                <Grid HeightRequest="44" ColumnDefinitions="30,*" Padding="10,0" HorizontalOptions="Fill">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowExecuteJobCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" Text="▶️" FontSize="15" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding Localization.ExecuteNav}"
                           TextColor="Black"
                           FontSize="15"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"/>
                </Grid>

                <Grid HeightRequest="44" ColumnDefinitions="30,*" Padding="10,0" HorizontalOptions="Fill">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowSettingsCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" Text="⚙️" FontSize="15" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding Localization.SettingsNav}"
                           TextColor="Black"
                           FontSize="15"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"/>
                </Grid>

                <!-- Spacer -->
                <BoxView HeightRequest="1" Color="#E0E0E0" Margin="10,15"/>

                <!-- Language Toggle -->
                <Grid HeightRequest="40" ColumnDefinitions="30,*" Padding="10,0" HorizontalOptions="Fill">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleLanguageCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" Text="🌐" FontSize="13" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding Localization.LanguageToggleNav}"
                           TextColor="Gray"
                           FontSize="13"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"/>
                </Grid>

            </VerticalStackLayout>
        </Border>

        <!-- Content Area - DataTemplateSelector approach -->
        <ContentView Grid.Column="1" BindingContext="{Binding CurrentViewModel}">
            <!-- We use a ContentView and swap content programmatically -->
        </ContentView>

    </Grid>

</ContentPage>
