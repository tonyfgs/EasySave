<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Presentation.ViewModels"
             xmlns:model="clr-namespace:Model"
             x:Class="Presentation.Views.JobListPage"
             x:DataType="vm:JobListViewModel"
             Title="Mes Sauvegardes">
    
    <Grid RowDefinitions="Auto, *, Auto" Padding="20" RowSpacing="10">

        <Button Grid.Row="0" 
                Text="🔄 Recharger la liste" 
                Command="{Binding LoadJobsCommand}"/>
        
    </Grid>
</ContentPage>